# QuickKasir Print Server Configuration

# Server Port
PORT=3001

# Printer Type: usb, network
PRINTER_TYPE=usb

# Printer Width (auto-adjust for different thermal printer sizes)
# Options: auto, 58mm, 80mm, 80mm-wide, or custom number (e.g., 24, 32, 48)
# - auto: Default 32 chars (80mm standard)
# - 58mm: 24 chars (smaller thermal printer)
# - 80mm: 32 chars (standard thermal printer)
# - 80mm-wide: 48 chars (80mm with smaller font)
PRINTER_WIDTH=auto

# USB Printer (optional - leave empty to auto-detect)
# Find VID/PID using: node list-printers.js
PRINTER_VID=
PRINTER_PID=

# Network Printer (only if PRINTER_TYPE=network)
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100

# Logging
LOG_LEVEL=info
